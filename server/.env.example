# Copy this file to `.env` (same folder) and paste your key after the = sign.
# Never commit .env or share your key in chat.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
PORT=3000
DAILY_MESSAGE_LIMIT=60
# AI safety check that runs alongside every chat message (on/off) and the model it uses
SAFETY_CHECK=on
SAFETY_MODEL=claude-haiku-5-5
# Parent page login (http://localhost:3000/parent). Email is optional locally.
PARENT_EMAIL=
PARENT_PASSWORD=1234

# ---- Cloud only (set these on Render, not here) ----
# HOST=0.0.0.0
# DATABASE_URL=postgresql://...      (Neon connection string)
# DEVICE_TOKEN=...                    (long random text; the pet sends it)
# SESSION_SECRET=...                  (long random text; signs parent login cookies)
# TZ=America/Los_Angeles              (so "today" matches your time zone)
